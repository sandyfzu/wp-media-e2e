# Dependencies
node_modules/

# Build output and coverage
dist/
build/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.*
!.env.example

# Caches and incremental build info
.cache/
.eslintcache
*.tsbuildinfo

# OS / editor noise
.DS_Store
Thumbs.db

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Per-run authentication state (storageState)
/.auth/

# Ephemeral resolved plugin artifacts (zips under test) — wiped & rebuilt each run
/.artifacts/

# Accumulating per-cell reports (pruned as each run ends, and by npm run report:prune)
/reports/

# Allure — results + generated report live under /reports/; these cover root-level/manual runs
/allure-results/
/allure-report/
/allure-history.jsonl

# playwright-bdd generated specs
/.features-gen/

# Per-product site pools & secrets (committed example only)
src/projects/*/config/sites.json
src/projects/*/config/sites.*.json
!src/projects/*/config/sites.example.json

# User provided plugins directory
plugins

# Claude Code local state (the rest of .claude/ — agents, skills, settings.json — is committed)
/.claude/worktrees/
/.claude/settings.local.json
