# Copy to `.env` for local runs. Loaded automatically by src/common/config/load-env.ts.
# Real environment variables (e.g. CI secrets) always win over values set here.

# ── Runtime flags (optional; sensible defaults) ──────────────────────────────
# Reporting mode: unset = self-contained portable report; "rich" = external
# attachments + embedded trace viewer (serve over http).
# REPORT_MODE=rich

# Cell (Playwright project) to run. Normally passed as `--project=<cell>`; this env
# var is honored too (used by the orchestrator). Exactly one cell per invocation.
# CELL=apache

# Per-run report token. Auto-stamped when unset; an orchestrator may pin it so a
# batch of cells shares one token.
# RUN_ID=

# Set non-empty in CI to enable CI-only config (retries, forbidOnly).
# CI=

# Artifact root overrides. The `<product>/<cell>` namespace is always appended,
# so cells never collide regardless of these values.
# REPORT_ROOT=reports
# OUTPUT_ROOT=test-results
# AUTH_ROOT=.auth

# ── BackWPup storage credentials ─────────────────────────────────────────────
# Required for BackWPup remote-storage runs; ignored by WP Rocket. Any of these can
# be overridden per site via the "overrides" block in src/projects/backwpup/config/sites.json.
BWP_FTP_HOST=
BWP_FTP_USERNAME=
BWP_FTP_PASSWORD=
BWP_FTP_PORT=21
BWP_FTP_SECURE=true
BWP_S3_ACCESS_KEY_ID=
BWP_S3_SECRET_ACCESS_KEY=
BWP_S3_BUCKET=
BWP_S3_REGION=us-east-1
