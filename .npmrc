# Allow THIS project's dependency install scripts to run on `npm install` — notably
# Playwright's `postinstall`, which downloads the Chromium browser. This overrides a
# globally-set `ignore-scripts=true` for this repo only, so a fresh `npm install`
# provisions the browser automatically. Dependencies here are vetted (Playwright,
# ESLint, TypeScript, Prettier); review new dependencies before adding them.
ignore-scripts=false
